# Flask settings
FLASK_APP=app.py
FLASK_DEBUG=True
PORT=5000

# Security
SECRET_KEY=develop_secret_key_change_in_production
JWT_SECRET_KEY=develop_jwt_secret_key_change_in_production

# Database
# Default: sqlite:///restaurant.db
# MySQL option: mysql+pymysql://username:password@localhost/db_name
# PostgreSQL option: postgresql://username:password@localhost/db_name
DATABASE_URL=sqlite:///restaurant.db
